{
  "name": "@sellerpro/backend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "overrides": { "deepmerge-ts": "^8.0.0", "exceljs": { "uuid": "^11.1.1" } },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/multer": "^2.0.0"
  }
}
